{
    "name": "@cynosure-mcp/defuddle",
    "mcpName": "io.github.andreasjhagen/defuddle",
    "version": "1.0.1",
    "description": "MCP server that wraps defuddle to extract clean content and metadata from web pages, including YouTube transcripts",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "defuddle-mcp": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx src/index.ts",
        "release:check": "node scripts/sync-version.mjs --check",
        "version": "node scripts/sync-version.mjs && git add server.json"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "defuddle": "^0.18.0",
        "jsdom": "^26.1.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    },
    "files": [
        "dist",
        "server.json",
        "icon.png"
    ],
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "defuddle",
        "web-scraping",
        "content-extraction",
        "markdown",
        "youtube",
        "ai"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-defuddle.git"
    },
    "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-defuddle#readme",
    "bugs": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-defuddle/issues"
    }
}
